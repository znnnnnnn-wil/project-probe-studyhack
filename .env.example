# 当前副本独立运行，默认不调用外部模型、不发起付款。
PORT=8180
BIND_ADDRESS=127.0.0.1
APP_ORIGIN=http://localhost:5273
SECURE_COOKIE=false
PRACTICE_MAX_TURNS=5
MODEL_MODE=demo
PAYMENT_MODE=mock
SPEECH_ENABLED=false

# 使用真实 AI 时，在自己的本地 .env 中配置；密钥只由后端读取。
# MODEL_MODE=live
# MODEL_PROVIDER=DashScope
# MODEL_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
# MODEL_NAME=填写你已开通的模型名称
# MODEL_API_KEY=填写你自己的密钥

# 面试官云端语音（DashScope CosyVoice，按字符计费，密钥只由后端读取）。
# 未单独配置 TTS_API_KEY 时复用 MODEL_API_KEY（需 MODEL_PROVIDER=DashScope）。
# TTS_ENABLED=true
# TTS_PAID_ALLOWED=true
# TTS_MODEL=cosyvoice-v2
# TTS_VOICE=longcheng_v2
# TTS_DAILY_LIMIT=60
